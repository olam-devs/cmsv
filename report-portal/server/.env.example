# Copy to .env (same folder as package.json)
PORT=3002

# Portal login (separate from main Helion fleet app)
REPORT_PORTAL_USERNAME=Helion
REPORT_PORTAL_PASSWORD=report@2026
REPORT_JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
REPORT_JWT_EXPIRES_IN=12h

# CMSV6 — same as main middleware (local Tomcat on VPS)
CMSV6_BASE_URL=http://127.0.0.1:8080
CMSV6_USERNAME=admin
CMSV6_PASSWORD=your_cmsv_password

FLEET_TIMEZONE=Africa/Dar_es_Salaam
DAILY_REPORT_CONCURRENCY=8
DAILY_REPORT_CACHE_MS=180000
